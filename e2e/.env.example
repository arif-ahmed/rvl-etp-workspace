# ETP E2E test configuration (all optional; defaults shown).
# Copy to .env or export in your shell before running.

# Portals
E2E_USER_PORTAL_URL=http://localhost:4201
E2E_ADMIN_PORTAL_URL=http://localhost:4200

# Backend services (direct, for API helpers and health checks)
E2E_EVENT_URL=http://localhost:5103
E2E_BOOKING_URL=http://localhost:5102
E2E_MOCK_IDENTITY_URL=http://localhost:5120
E2E_TSP_MOCK_URL=http://localhost:5130

# Seeded accounts (scripts/Seed-EtpCognitoUsers.ps1 / Seed-EtpData.ps1)
E2E_USER_PHONE=1700000011
E2E_USER_PASSWORD=Passw0rd!23
E2E_ADMIN_PHONE=1700000001
E2E_ADMIN_PASSWORD=Passw0rd!23
E2E_ADMIN_OTP=123456

# mock-identity OTP (server default 123456)
E2E_MOCK_OTP=123456

# Screenshots: 'on' captures every test, default captures failures only
E2E_SCREENSHOT=only-on-failure

# Set to 1 to enable the phase-2 admin portal suite
E2E_RUN_ADMIN=
