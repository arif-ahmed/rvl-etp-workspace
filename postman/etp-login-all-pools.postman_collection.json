{
  "info": {
    "_postman_id": "5e45682b-1d97-5321-12b6-8ae8127998ed",
    "name": "ETP - Login (all pools)",
    "description": "Logs in every seeded user across the Admin, User, TicketChecker and Agent Cognito pools and stores access_token_* / id_token_* / refresh_token_* in the environment 'ETP Local - Services'. Run folder '00 - Resolve' first, then the pool folders (or the whole collection). Prereq: floci/seed-users.ps1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Resolve",
      "item": [
        {
          "name": "Resolve pool ids (ListUserPools)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const pools = pm.response.json().UserPools || [];",
                  "{ const p = pools.find(x => x.Name === 'etp-admin'); pm.test('pool etp-admin exists (run floci/seed-users.ps1)', () => pm.expect(p).to.exist); if (p) pm.environment.set('admin_pool_id', p.Id); }",
                  "{ const p = pools.find(x => x.Name === 'etp-user'); pm.test('pool etp-user exists (run floci/seed-users.ps1)', () => pm.expect(p).to.exist); if (p) pm.environment.set('user_pool_id', p.Id); }",
                  "{ const p = pools.find(x => x.Name === 'etp-ticketchecker'); pm.test('pool etp-ticketchecker exists (run floci/seed-users.ps1)', () => pm.expect(p).to.exist); if (p) pm.environment.set('ticketchecker_pool_id', p.Id); }",
                  "{ const p = pools.find(x => x.Name === 'etp-agent'); pm.test('pool etp-agent exists (run floci/seed-users.ps1)', () => pm.expect(p).to.exist); if (p) pm.environment.set('agent_pool_id', p.Id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-amz-json-1.1"
              },
              {
                "key": "X-Amz-Target",
                "value": "AWSCognitoIdentityProviderService.ListUserPools"
              }
            ],
            "url": "{{floci_url}}/",
            "description": "Run first. Resolves the four pool ids from the seeded pool names.",
            "auth": {
              "type": "awsv4",
              "awsv4": [
                {
                  "key": "accessKey",
                  "value": "{{aws_access_key}}",
                  "type": "string"
                },
                {
                  "key": "secretKey",
                  "value": "{{aws_secret_key}}",
                  "type": "string"
                },
                {
                  "key": "region",
                  "value": "{{aws_region}}",
                  "type": "string"
                },
                {
                  "key": "service",
                  "value": "cognito-idp",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"MaxResults\": 60\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Resolve admin client id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const c = (pm.response.json().UserPoolClients || []).find(c => c.ClientName === pm.environment.get('client_name'));",
                  "pm.test('app client exists', () => pm.expect(c).to.exist);",
                  "if (c) pm.environment.set('admin_client_id', c.ClientId);"
                ]
