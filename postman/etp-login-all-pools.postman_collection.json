                  "function jwt(t){const p=t.split('.')[1].replace(/-/g,'+').replace(/_/g,'/');return JSON.parse(CryptoJS.enc.Utf8.stringify(CryptoJS.enc.Base64.parse(p)));}",
                  "pm.test('200 InitiateAuth', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json().AuthenticationResult;",
                  "pm.test('token issued (no challenge)', () => pm.expect(r).to.exist);",
                  "if (!r) return;",
                  "pm.environment.set('access_token_agent', r.AccessToken);",
                  "pm.environment.set('id_token_agent', r.IdToken);",
                  "pm.environment.set('refresh_token_agent', r.RefreshToken);",
                  "pm.test('id token custom:role = agent', () => pm.expect(jwt(r.IdToken)['custom:role']).to.eql('agent'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-amz-json-1.1"
              },
              {
                "key": "X-Amz-Target",
                "value": "AWSCognitoIdentityProviderService.InitiateAuth"
              }
            ],
            "url": "{{floci_url}}/",
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"AuthFlow\": \"USER_PASSWORD_AUTH\",\n  \"ClientId\": \"{{agent_client_id}}\",\n  \"AuthParameters\": {\n    \"USERNAME\": \"{{phone_agent}}\",\n    \"PASSWORD\": \"{{test_password}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
